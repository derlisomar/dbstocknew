APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Asuncion
DB_TIMEZONE=America/Asuncion

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Respaldos automáticos (php artisan respaldo:base)
# BACKUP_DIR=/var/respaldos/dbstock
# BACKUP_DIAS=14

# --- Página pública y demo (Parte 9) ---
# Dos dominios (opcional): página pública y sistema separados. Con APP_URL=https://app.tudominio.com
# false en la instalación de un cliente: sin página pública, entra directo al sistema
LANDING_ACTIVA=true
LANDING_DOMINIO=
LANDING_DOMINIO_APP=
LANDING_EMPRESA="Dobi Soluciones Informáticas"
LANDING_WHATSAPP=595973615297
LANDING_CORREO=info@dobipy.com
LANDING_DEMO=true
LANDING_DEMO_DIAS=7
LANDING_DEMO_MAX=100
# Correo de las demos con una casilla de cPanel (Correo > Cuentas de correo > "Configurar cliente de correo").
# Poné estos valores en el .env del servidor, NO en este archivo de ejemplo. La contraseña es la de la casilla.
# MAIL_MAILER=smtp
# MAIL_HOST=mail.dobipy.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=info@dobipy.com
# MAIL_PASSWORD=la-contraseña-de-esa-casilla
# MAIL_FROM_ADDRESS="info@dobipy.com"
# MAIL_FROM_NAME="Dobi Soluciones Informáticas"
# (Si el puerto 465 no te anda, probá MAIL_PORT=587 y MAIL_SCHEME=null.)
